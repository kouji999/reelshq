{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "depends": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "depends": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}